# Generated documentation — run `sbcl --load run-docs.lisp` to regenerate.
# The source is docs/apeiron-docs.lisp + the embedded sections in
# src/core/*.lisp; the generated site is published to GitHub Pages by
# .github/workflows/docs.yml (docs/build/ -> gh-pages branch).
docs/build/

# Compiled artifacts
*.fasl
*.fas

# Qlot environment.  It is what the CI actions (40ants/setup-lisp,
# 40ants/run-tests) build from qlfile; local development uses plain
# Quicklisp, so there is normally no .qlot/ directory here.
.qlot/
